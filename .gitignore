# .gitignore for bold-ship
# Purpose: ignore OS files, IDE files, build artifacts, dependencies,
# secrets, local environment files, databases, and other noisy files

#########################
# OS / system files
#########################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

#########################
# Node / JavaScript
#########################
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
*.tgz
.cache/
.parcel-cache/
dist/
dist-ssr/
build/
out/
.next/
.vite/
/.turbo
/.cache/

#########################
# TypeScript / JS artifacts
#########################
*.tsbuildinfo
*.js.map
*.d.ts.map

#########################
# Python
#########################
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pytest_cache/
pip-log.txt
pip-delete-this-directory.txt

#########################
# Databases
#########################
# Local sqlite / DB files - don't commit local DB snapshots
*.db
*.sqlite
*.sqlite3
/backend/social_amplifier.db

#########################
# Environment / secret files
#########################
# Ignore all env files but keep example files (tracked) if present
.env
.env.*
local.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!backend/.env.example

#########################
# Logs, reports, coverage
#########################
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
coverage/
.nyc_output/
report/

#########################
# Editor / IDE
#########################
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

#########################
# Containers / Docker
#########################
docker-compose.override.yml
.docker/
docker-compose.env.*

#########################
# Build / temp files
#########################
tmp/
temp/
cache/
dist/
build/
out/
*.local
*.bak
*.tmp
*.swp

#########################
# Misc
#########################
*.seed
*.pid
*.pid.lock
*.log
*.csv
*.tsv
*.gz

#########################
# IDE / OS lock & system files
#########################
Thumbs.db
desktop.ini
Icon\r

#########################
# Optional: generated by editors/tools
#########################
*.swo
*.swn
*.tmp

docs/
backend/RENDER_DEPLOYMENT.md
backend/DEPLOYMENT.md
FRONTEND_DEPLOYMENT.md

# End of .gitignore
