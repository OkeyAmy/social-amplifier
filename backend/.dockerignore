# =============================================================================
# .dockerignore - Exclude unnecessary files from Docker build context
# =============================================================================

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# Database files (will be created in container)
*.db
*.sqlite
*.sqlite3
social_amplifier.db

# Environment files (should be set via Render.com environment variables)
.env
.env.local
.env.*.local
*.env

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Documentation
*.md
docs/
DEPLOYMENT.md
README.md

# Git
.git/
.gitignore
.gitattributes

# Logs
*.log
logs/

# OS files
Thumbs.db
.DS_Store

# Build artifacts
dist/
build/
*.egg-info/

# Scripts (not needed in production container)
start.sh
start.bat

# Temporary files
*.tmp
*.bak
*.swp

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

